# --- Database ---
# Local convention: "personal_assistant_dev" database on a native Postgres
# install, using the default postgres role. Full instructions: docs/database-setup.md
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_assistant_dev

# --- LLM provider selection (read by llm/factory.py via config.py) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5

# --- Provider API keys (only the one matching LLM_PROVIDER is strictly required) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- Google OAuth (Calendar API — Calendar sub-agent, Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail (email sub-agent, later phase) ---
GMAIL_APP_PASSWORD=

# --- LangSmith / tracing ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multiagent-pa
LANGCHAIN_TRACING_V2=true
