# Where the FastAPI backend is listening (api/main.py, API_HOST/API_PORT).
# Read on the server only: the read screens are server components, so the
# browser never needs this and it is never bundled into client JS.
API_BASE_URL=http://127.0.0.1:8000

# The same URL as the browser will see it, for the client-side calls that
# arrive with W2's mutations. Must match WEB_ORIGIN's counterpart in the
# backend's CORS config.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
